{
  "name": "feedmelean",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:worker": "wrangler dev --port 8788",
    "dev": "npm run build && wrangler dev --port 8788",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply feedmelean-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply feedmelean-db --remote",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:production": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@tailwindcss/vite": "^4.0.8",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^3.0.7",
    "wrangler": "^3.109.2"
  }
}

